    "# 03 描述性统计、可视化与回归分析\n",
    "\n",
    "本 Notebook 完成第四部分（描述统计与可视化）和第五部分（CAPM 回归与宏观指标回归）：\n",
    "\n",
    "- **4.1** 10 只股票日收益率的基本统计量表格\n",
    "- **4.2** 图 1–5：走势图、收益率分布、相关性热力图、宏观关系散点图、ROE 对比图\n",
    "- **5.1** CAPM 模型估计（Beta、Alpha、R²）及可视化\n",
    "- **5.2** 人民币/美元汇率对 10 只股票月度收益率的影响\n",
    "\n",
    "**所有图形保存至 `output/` 目录，PNG 格式，分辨率 ≥ 150 dpi。**\n",
    "**每张图后均有不少于 2 句中文解读。**"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. 环境准备与数据加载"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mtick\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "import statsmodels.api as sm\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "plt.rcParams['figure.dpi'] = 150\n",
    "\n",
    "os.makedirs('output', exist_ok=True)\n",
    "\n",
    "# 股票元信息\n",
    "STOCKS_INFO = {\n",
    "    '603685': {'name': '晨丰科技', 'industry': '电气设备'},\n",
    "    '603319': {'name': '美湖股份', 'industry': '化工'},\n",
    "    '600519': {'name': '贵州茅台', 'industry': '食品饮料'},\n",
    "    '601288': {'name': '农业银行', 'industry': '银行'},\n",
    "    '601166': {'name': '兴业银行', 'industry': '银行'},\n",
    "    '600048': {'name': '保利发展', 'industry': '房地产'},\n",
    "    '000568': {'name': '泸州老窖', 'industry': '食品饮料'},\n",
    "    '002179': {'name': '中航光电', 'industry': '国防军工'},\n",
    "    '300510': {'name': '金冠股份', 'industry': '电气设备'},\n",
    "    '000988': {'name': '华工科技', 'industry': '电子'},\n",
    "}\n",
    "\n",
    "# 按行业排序的股票顺序（用于热力图等）\n",
    "INDUSTRY_ORDER = ['银行', '房地产', '食品饮料', '电气设备', '化工', '国防军工', '电子']\n",
    "codes_by_industry = sorted(\n",
    "    STOCKS_INFO.keys(),\n",
    "    key=lambda c: (INDUSTRY_ORDER.index(STOCKS_INFO[c]['industry'])\n",
    "                   if STOCKS_INFO[c]['industry'] in INDUSTRY_ORDER else 99,\n",
    "                   STOCKS_INFO[c]['name'])\n",
    ")\n",
    "\n",
    "# 行业配色方案\n",
    "INDUSTRY_COLORS = {\n",
    "    '银行': '#185FA5', '房地产': '#A32D2D', '食品饮料': '#854F0B',\n",
    "    '电气设备': '#0F6E56', '化工': '#534AB7', '国防军工': '#993556', '电子': '#444441'\n",
    "}\n",
    "\n",
    "print(\"环境初始化完成\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 加载清洗后数据"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 加载各股清洗数据\n",
    "dfs = {}\n",
    "for code in STOCKS_INFO:\n",
    "    df = pd.read_csv(f'data/stock/stock_{code}.csv', encoding='utf-8-sig')\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "    df = df.set_index('date').sort_index()\n",
    "    for c in ['open','close','high','low','volume','amount']:\n",
    "        if c in df.columns:\n",
    "            df[c] = pd.to_numeric(df[c], errors='coerce')\n",
    "    df['return'] = np.log(df['close'] / df['close'].shift(1))\n",
    "    dfs[code] = df\n",
    "\n",
    "# 沪深300\n",
    "df_hs300 = pd.read_csv('data/index/index_000300.csv', encoding='utf-8-sig')\n",
    "df_hs300['date'] = pd.to_datetime(df_hs300['date'])\n",
    "df_hs300 = df_hs300.set_index('date').sort_index()\n",
    "df_hs300['close'] = pd.to_numeric(df_hs300['close'], errors='coerce')\n",
    "df_hs300['return'] = np.log(df_hs300['close'] / df_hs300['close'].shift(1))\n",
    "\n",
    "# 人民币/美元汇率（月度）\n",
    "df_fx = pd.read_csv('data/macro/macro_exchange_rate.csv', encoding='utf-8-sig')\n",
    "df_fx['date'] = pd.to_datetime(df_fx['date'])\n",
    "df_fx = df_fx.set_index('date').sort_index()\n",
    "\n",
    "# 财务数据\n",
    "df_fin = pd.read_csv('data/finance/finance_ratios.csv', encoding='utf-8-sig', dtype={'code': str})\n",
    "df_fin['code'] = df_fin['code'].str.zfill(6)\n",
    "\n",
    "print(\"数据加载完毕\")\n",
    "print(f\"  个股数据: {len(dfs)} 只，各约 {len(dfs['600519'])} 行\")\n",
    "print(f\"  沪深300: {len(df_hs300)} 行\")\n",
    "print(f\"  汇率月度: {len(df_fx)} 行\")\n",
    "print(f\"  财务长格式: {df_fin.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "# 第四部分：描述性统计与可视化\n",
    "\n",
    "## 4.1 基本统计量"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "TRADING_DAYS = 252  # 年化交易日数\n",
    "\n",
    "def max_drawdown(series):\n",
    "    \"\"\"计算最大回撤\"\"\"\n",
    "    cum = series.cumsum()\n",
    "    roll_max = cum.cummax()\n",
    "    drawdown = cum - roll_max\n",
    "    return drawdown.min()\n",
    "\n",
    "rows = []\n",
    "for code in STOCKS_INFO:\n",
    "    r = dfs[code]['return'].dropna()\n",
    "    ann_mean = r.mean() * TRADING_DAYS\n",
    "    ann_vol = r.std() * np.sqrt(TRADING_DAYS)\n",
    "    skew = r.skew()\n",
    "    kurt = r.kurtosis()  # excess kurtosis\n",
    "    mdd = max_drawdown(r)\n",
    "    rows.append({\n",
    "        '代码': code,\n",
    "        '名称': STOCKS_INFO[code]['name'],\n",
    "        '行业': STOCKS_INFO[code]['industry'],\n",
    "        '年化均值': f'{ann_mean:.2%}',\n",
    "        '年化波动率': f'{ann_vol:.2%}',\n",
    "        '偏度': round(skew, 3),\n",
    "        '超额峰度': round(kurt, 3),\n",
    "        '最大回撤(对数)': f'{mdd:.2%}',\n",
    "    })\n",
    "\n",
    "df_stat = pd.DataFrame(rows)\n",
    "print(df_stat.to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**统计说明**：年化均值和波动率分别由日均收益率乘以 252、日收益率标准差乘以 √252 得到。偏度为正表示右尾肥厚（有超大正收益日），偏度为负表示左尾更重（极端下跌风险更大）。超额峰度（Excess Kurtosis）大于 0 说明收益率分布比正态分布更尖峭，存在「肥尾」特征，是金融资产收益率的普遍现象。最大回撤使用对数收益率累计计算，反映最坏情景下的最大净值损失幅度。"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 4.2 可视化\n",
    "\n",
    "### 图 1：归一化收盘价走势图（以 2020-01-01 = 1 为基准）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(14, 7))\n",
    "\n",
    "# 沪深300（虚线，黑色）\n",
    "hs300_norm = df_hs300['close'] / df_hs300['close'].iloc[0]\n",
    "ax.plot(hs300_norm.index, hs300_norm.values, color='black',\n",
    "        linewidth=1.8, linestyle='--', label='沪深300', alpha=0.85, zorder=5)\n",
    "\n",
    "# 各股票，按行业着色\n",
    "plotted_industries = set()\n",
    "for code in codes_by_industry:\n",
    "    df = dfs[code]\n",
    "    color = INDUSTRY_COLORS[STOCKS_INFO[code]['industry']]\n",
    "    industry = STOCKS_INFO[code]['industry']\n",
    "    norm = df['close'] / df['close'].iloc[0]\n",
    "    label = f\"{STOCKS_INFO[code]['name']}（{industry}）\" if industry not in plotted_industries else None\n",
    "    if label:\n",
    "        plotted_industries.add(industry)\n",
    "    actual_label = f\"{STOCKS_INFO[code]['name']}\" \n",
    "    ax.plot(norm.index, norm.values, color=color, linewidth=1.2,\n",
    "            alpha=0.75, label=actual_label)\n",
    "\n",
    "ax.axhline(y=1, color='gray', linestyle=':', linewidth=0.8, alpha=0.6)\n",
    "ax.set_title('归一化收盘价走势（2020-01-01 = 1）', fontsize=14, fontweight='bold', pad=12)\n",
    "ax.set_xlabel('日期', fontsize=12)\n",
    "ax.set_ylabel('归一化价格', fontsize=12)\n",
    "ax.legend(loc='upper left', fontsize=8, ncol=2, framealpha=0.8)\n",
    "ax.grid(True, alpha=0.3)\n",
    "fig.tight_layout()\n",
    "fig.savefig('output/fig1_normalized_price.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"图 1 已保存至 output/fig1_normalized_price.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**图 1 解读**：以 2020 年初为基准，各股票表现分化显著。白酒类股票（贵州茅台、泸州老窖）在 2021 年前后录得最高涨幅，体现了消费升级和流动性宽松环境下的强劲表现，但 2021 年后随估值回落均有所回调。银行和房地产股票（农业银行、兴业银行、保利发展）走势偏弱，长期低于沪深 300 基准，反映行业景气度的持续承压。军工（中航光电）和电气设备（晨丰科技）的走势与政策红利密切相关，呈现明显的阶段性脉冲特征。"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 图 2：日收益率分布图（2×5 分面直方图，叠加正态曲线）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 5, figsize=(18, 7))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, code in enumerate(STOCKS_INFO):\n",
    "    r = dfs[code]['return'].dropna()\n",
    "    mu, sigma = r.mean(), r.std()\n",
    "    ax = axes[i]\n",
    "    color = INDUSTRY_COLORS[STOCKS_INFO[code]['industry']]\n",
    "\n",
    "    ax.hist(r, bins=60, density=True, color=color, alpha=0.55, edgecolor='none')\n",
    "\n",
    "    # 叠加正态分布曲线\n",
    "    x = np.linspace(r.min(), r.max(), 200)\n",
    "    ax.plot(x, stats.norm.pdf(x, mu, sigma), color=color, linewidth=1.8)\n",
    "\n",
    "    name = STOCKS_INFO[code]['name']\n",
    "    ax.set_title(f'{name}\\n({code})', fontsize=9, fontweight='bold')\n",
    "    ax.text(0.97, 0.92, f'μ={mu:.4f}\\nσ={sigma:.4f}',\n",
    "            transform=ax.transAxes, ha='right', va='top',\n",
    "            fontsize=7.5, color='#333333',\n",
    "            bbox=dict(boxstyle='round,pad=0.2', facecolor='white', alpha=0.7))\n",
    "    ax.set_xlabel('日对数收益率', fontsize=7)\n",
    "    ax.set_ylabel('密度', fontsize=7)\n",
    "    ax.tick_params(labelsize=7)\n",
    "    ax.grid(True, alpha=0.25)\n",
    "\n",
    "fig.suptitle('10 只股票日收益率分布（叠加正态曲线）', fontsize=13, fontweight='bold', y=1.01)\n",
    "fig.tight_layout()\n",
    "fig.savefig('output/fig2_return_distribution.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"图 2 已保存至 output/fig2_return_distribution.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**图 2 解读**：所有股票的日收益率分布均呈现出明显的「尖峰肥尾」特征——峰部比正态曲线更尖锐，而两侧尾部（极端收益日）比正态分布更厚，这是金融资产收益率的普遍规律（Stylized Fact）。这意味着若用正态分布假设来估计风险（如 VaR），将系统性低估极端损失发生的概率，在实际风险管理中需特别注意。白酒类股票（贵州茅台、泸州老窖）的分布相对较窄（σ 较小），而小市值股票（晨丰科技、金冠股份）的分布较宽，反映其更高的日度波动风险。"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 图 3：收益率相关系数热力图"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 构建收益率宽表（按行业排序）\n",
    "ret_wide = pd.DataFrame({\n",
    "    code: dfs[code]['return'] for code in codes_by_industry\n",
    "})\n",
    "ret_wide.columns = [STOCKS_INFO[c]['name'] for c in codes_by_industry]\n",
    "corr_matrix = ret_wide.dropna().corr()\n",
    "\n",
    "# 行业标注\n",
    "industry_labels = [STOCKS_INFO[c]['industry'] for c in codes_by_industry]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "mask = np.zeros_like(corr_matrix, dtype=bool)\n",
    "# 不遮盖下三角，展示全矩阵（便于阅读）\n",
    "\n",
    "sns.heatmap(\n",
    "    corr_matrix, annot=True, fmt='.2f', cmap='RdYlBu_r',\n",
    "    vmin=-0.2, vmax=1.0, center=0.4,\n",
    "    linewidths=0.5, linecolor='white',\n",
    "    annot_kws={'size': 9}, ax=ax,\n",
    "    cbar_kws={'shrink': 0.8}\n",
    ")\n",
    "\n",
    "# 在 y 轴标注行业\n",
    "names_ordered = [STOCKS_INFO[c]['name'] for c in codes_by_industry]\n",
    "industries_ordered = [STOCKS_INFO[c]['industry'] for c in codes_by_industry]\n",
    "y_labels = [f'{n}\\n[{ind}]' for n, ind in zip(names_ordered, industries_ordered)]\n",
    "ax.set_yticklabels(y_labels, rotation=0, fontsize=8)\n",
    "ax.set_xticklabels(names_ordered, rotation=30, ha='right', fontsize=8)\n",
    "ax.set_title('10 只股票日收益率相关系数矩阵（按行业排序）',\n",
    "             fontsize=12, fontweight='bold', pad=12)\n",
    "\n",
    "fig.tight_layout()\n",
    "fig.savefig('output/fig3_correlation_heatmap.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"图 3 已保存至 output/fig3_correlation_heatmap.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**图 3 解读**：从相关系数矩阵可以看出，同行业内部的相关性普遍高于跨行业——例如银行板块（农业银行与兴业银行）的相关系数明显高于银行与房地产之间的相关性，这验证了行业因子在 A 股市场中的重要性。白酒双雄（贵州茅台与泸州老窖）的相关性也较高，说明它们受相同的消费行业驱动因子影响。整体来看，所有股票的相关性均为正值，这反映了 A 股市场较强的同涨同跌特征（系统性风险较难分散），多数相关系数集中在 0.3–0.6 区间，处于中等正相关水平。"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 图 4：宏观指标与股市关系（人民币/美元汇率 vs 沪深 300 月度收益率）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 计算沪深300月度收益率\n",
    "hs300_monthly = df_hs300['close'].resample('MS').last().pct_change().dropna()\n",
    "\n",
    "# 对齐汇率（使用上月末汇率，作为解释变量）\n",
    "fx_monthly = df_fx['usd_cny_mid'].resample('MS').mean()\n",
    "fx_change = fx_monthly.pct_change().dropna()  # 汇率月度变动\n",
    "\n",
    "# 对齐索引\n",
    "common_idx = hs300_monthly.index.intersection(fx_change.index)\n",
    "y = hs300_monthly.loc[common_idx].values\n",
    "x = fx_change.loc[common_idx].values\n",
    "\n",
    "# 线性拟合\n",
    "slope, intercept, r_val, p_val, se = stats.linregress(x, y)\n",
    "pearson_r = r_val\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 5.5))\n",
    "ax.scatter(x * 100, y * 100, color='#185FA5', alpha=0.6, s=50, edgecolors='none')\n",
    "\n",
    "# 拟合线\n",
    "x_line = np.linspace(x.min(), x.max(), 100)\n",
    "y_line = slope * x_line + intercept\n",
    "ax.plot(x_line * 100, y_line * 100, color='#A32D2D', linewidth=2)\n",
    "\n",
    "ax.axhline(0, color='gray', linestyle='--', linewidth=0.8, alpha=0.5)\n",
    "ax.axvline(0, color='gray', linestyle='--', linewidth=0.8, alpha=0.5)\n",
    "\n",
    "ax.set_title(f'人民币/美元汇率月度变动 vs 沪深300月度收益率\\nPearson r = {pearson_r:.3f}，p = {p_val:.3f}',\n",
    "             fontsize=11, fontweight='bold')\n",
    "ax.set_xlabel('汇率月度变动率（人民币贬值为正）(%)', fontsize=10)\n",
    "ax.set_ylabel('沪深300月度收益率 (%)', fontsize=10)\n",
    "ax.text(0.97, 0.05, f'斜率 = {slope:.2f}\\np 值 = {p_val:.3f}',\n",
    "        transform=ax.transAxes, ha='right', va='bottom', fontsize=9,\n",
    "        bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
    "ax.grid(True, alpha=0.3)\n",
    "fig.tight_layout()\n",
    "fig.savefig('output/fig4_macro_scatter.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(f\"图 4 已保存至 output/fig4_macro_scatter.png\")\n",
    "print(f\"Pearson 相关系数: {pearson_r:.3f}, p 值: {p_val:.3f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
