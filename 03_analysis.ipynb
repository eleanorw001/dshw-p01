    "---\n",
    "# 第五部分：回归分析\n",
    "\n",
    "## 5.1 CAPM 模型估计\n",
    "\n",
    "模型：$r_{i,t} - r_f = \\alpha_i + \\beta_i (r_{m,t} - r_f) + \\varepsilon_{i,t}$\n",
    "\n",
    "其中：\n",
    "- $r_{i,t}$：个股日对数收益率\n",
    "- $r_{m,t}$：沪深 300 日对数收益率（市场基准）\n",
    "- $r_f$：无风险利率，年化 2.0%，日频换算 $r_f^{\\text{daily}} = 0.02 / 252$\n",
    "- 使用 `statsmodels.OLS` 估计"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "RF_DAILY = 0.02 / 252  # 日无风险利率\n",
    "\n",
    "capm_results = []\n",
    "\n",
    "for code in STOCKS_INFO:\n",
    "    # 对齐个股与沪深300的日期\n",
    "    ri = dfs[code]['return'].dropna()\n",
    "    rm = df_hs300['return'].dropna()\n",
    "    common = ri.index.intersection(rm.index)\n",
    "\n",
    "    ri_exc = ri.loc[common] - RF_DAILY\n",
    "    rm_exc = rm.loc[common] - RF_DAILY\n",
    "\n",
    "    X = sm.add_constant(rm_exc)\n",
    "    model = sm.OLS(ri_exc, X).fit()\n",
    "\n",
    "    alpha = model.params['const']\n",
    "    beta = model.params.iloc[1]\n",
    "    alpha_pval = model.pvalues['const']\n",
    "    beta_ci_low = model.conf_int().iloc[1, 0]\n",
    "    beta_ci_high = model.conf_int().iloc[1, 1]\n",
    "    r2 = model.rsquared\n",
    "\n",
    "    capm_results.append({\n",
    "        '代码': code,\n",
    "        '名称': STOCKS_INFO[code]['name'],\n",
    "        '行业': STOCKS_INFO[code]['industry'],\n",
    "        'α(年化)': f'{alpha * 252:.4f}',\n",
    "        'α p值': f'{alpha_pval:.4f}',\n",
    "        'β': round(beta, 4),\n",
    "        'β 95%CI': f'[{beta_ci_low:.3f}, {beta_ci_high:.3f}]',\n",
    "        'R²': round(r2, 4),\n",
    "    })\n",
    "\n",
    "df_capm = pd.DataFrame(capm_results)\n",
    "print(df_capm.to_string(index=False))"
   ]
  },
